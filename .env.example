# Copier en .env puis remplir (ou lancer ./scripts/make-env.sh). Ne jamais commiter .env.
# Jeton d'envoi des machines (16 caractères min.) : openssl rand -hex 24
LEZARD_TOKEN=
# IP sur laquelle publier le port 3070 : l'IP LAN de l'hôte (ex. 192.168.1.10) pour que
# les machines puissent envoyer leurs relevés. 127.0.0.1 = accessible depuis l'hôte seulement.
LEZARD_BIND_IP=127.0.0.1
# Une machine sans relevé depuis cette durée passe « Hors ligne »
LEZARD_STALE=3m
# Une machine muette depuis cette durée disparaît de l'interface (l'historique reste)
LEZARD_FORGET=720h
# Relevés bruts gardés (1 à 30 jours), puis moyennes 10 min (30 j) puis horaires (400 j)
LEZARD_RAW_DAYS=3
# Nombre maximal de séries (machine × capteur) ; environ 0,6 Mo de mémoire par série sur un an
LEZARD_MAX_SERIES=100
# Mot de passe de la page Réglages (10 caractères min.) : bot Telegram, destinataires,
# seuils et noms se gèrent ensuite depuis l'interface. Vide = page Réglages désactivée.
LEZARD_ADMIN_PASSWORD=
# Fuseau horaire (plages calmes des alertes)
TZ=Europe/Paris
# Valeurs initiales, reprises seulement au tout premier démarrage (ensuite : page Réglages)
LEZARD_WARN=70
LEZARD_CRIT=80
# Seuils par machine : hote=attention/critique, séparés par des virgules (point décimal)
# ex. LEZARD_THRESHOLDS=serveur=80/88,nas=65/75
LEZARD_THRESHOLDS=
# Noms affichés : hote=Nom, ex. LEZARD_NAMES=nas=NAS,media=Média
LEZARD_NAMES=
